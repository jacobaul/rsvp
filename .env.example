# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production: point at the existing Postgres server. The database and role must
# already exist; the app creates its own tables via migrations on first start.
#   DATABASE_URL=postgres://rsvp:CHANGE_ME@db.internal:5432/rsvp
# Development: matches docker-compose.dev.yaml.
DATABASE_URL=postgres://rsvp:rsvp@localhost:5432/rsvp

# require (default) | verify-full | prefer | disable
# Use `disable` for the local dev container only.
DATABASE_SSL=disable

# ---------------------------------------------------------------------------
# Admin authentication
# ---------------------------------------------------------------------------
# 32+ random bytes: openssl rand -base64 32
SESSION_SECRET=

# Generate with: pnpm admin:password 'your-password'
# Paste the value unquoted. Fields are separated by "." and never "$", because
# Next.js loads .env through dotenv-expand, which strips $name references and
# would silently corrupt the hash.
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used for QR code URLs when the admin Settings page has no site URL set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloudflare tunnel token used by docker-compose.yaml
TUNNEL_TOKEN=
